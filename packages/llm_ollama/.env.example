# Used by integration tests under `test/integration/`.

# Optional. If unset, tests use the default base URL defined in test_helpers.dart.
OLLAMA_BASE_URL=

# Copy this file to `.env` in this directory.

# Optional. The model must exist on the Ollama the tests point at. The chat
# model must be tool-capable (`ollama show <model>` lists `tools`) — most of
# the suite is tool calling. Defaults: qwen3:8b and nomic-embed-text.
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=
