# Used by integration tests under `test/integration/`.
# Provide either an OpenAI API key or a ChatGPT access token.

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional alternative to OPENAI_API_KEY:
CHATGPT_ACCESS_TOKEN=

# Copy this file to `.env` in this directory.
