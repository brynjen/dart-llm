# Used by integration tests under `test/integration/`.
#
# Copy this file to `.env` in this directory.

# --- Chat -------------------------------------------------------------------
# Accepts a base URL with or without the `/v1` suffix.
VLLM_BASE_URL=http://localhost:8000
VLLM_CHAT_MODEL=Qwen/Qwen3-0.6B
VLLM_API_KEY=

# --- Embeddings -------------------------------------------------------------
# vLLM serves one model per process, so an embedding model runs as a separate
# instance on its own port. Leave VLLM_EMBEDDING_BASE_URL empty to reuse
# VLLM_BASE_URL (only correct if that instance serves an embedding model).
#
# Example split deployment:
#   VLLM_BASE_URL=http://localhost:8000            # a chat model
#   VLLM_EMBEDDING_BASE_URL=http://localhost:8001  # an embedding model
VLLM_EMBEDDING_BASE_URL=
VLLM_EMBEDDING_MODEL=Qwen/Qwen3-0.6B

# --- Gated suites -----------------------------------------------------------
# Tool calling additionally requires the server to run with
# --enable-auto-tool-choice and a --tool-call-parser matching the model's
# output format. Reasoning requires --reasoning-parser.
VLLM_ENABLE_TOOL_TESTS=false
VLLM_ENABLE_REASONING_TESTS=false
VLLM_ENABLE_EMBEDDING_TESTS=false
