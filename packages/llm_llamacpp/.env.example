# Used by integration tests under `test/integration/`.
# Paths must exist on this machine. You can also place GGUF files under test/models/.

# Path to a standard text model (GGUF)
LLAMA_TEST_MODEL=

# Path to a vision model (GGUF)
LLAMA_TEST_VISION_MODEL=

# Path to a small/fast model for quick tests
LLAMA_TEST_SMALL_MODEL=

# Number of GPU layers (0 = CPU only)
LLAMA_TEST_GPU_LAYERS=0

# Copy this file to `.env` in this directory.
