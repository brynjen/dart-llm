# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# Test coverage files
coverage/
**/coverage/
*.lcov

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
*.info.json      # Produced by the --dump-info flag.
*.js             # When generated by dart2js. Don't specify *.js if your
                 # project includes source files written in JavaScript.
*.js_
*.js.deps
*.js.map

.DS_Store

.flutter-plugins
.flutter-plugins-dependencies

# ========================================
# Build artifacts and native libraries
# ========================================

# CMake/C++ build outputs
build-android/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.o
*.d
compile_commands.json

# Shared libraries (native binaries)
*.so
*.so.*
*.dylib
*.dll

# Android native JNI libraries
**/jniLibs/

# Linux native libraries folder
**/linux/libs/

# Windows native libraries folder
**/windows/libs/

# Model files (can be very large)
*.gguf
*.bin

# APK and AAR files
*.apk
*.aar

# Flutter/Gradle build caches
**/example_app/build/
**/.gradle/
**/gradle-wrapper.jar

# ========================================
# Docker
# ========================================

# Don't ignore the Dockerfile itself, but ignore Docker build context artifacts
.docker/

# ========================================
# Dependencies downloaded by build scripts
# ========================================

# OpenCL/Vulkan headers cloned during build
build-android/deps/

# IDE
.idea/
*.iml
.vscode/

# Temporary files
*.tmp
*.temp
*.log

# Generated files
**/flutter/ephemeral/.plugin_symlinks/

# The llamacpp directory is a native C++ dependency tracked in git but excluded from
# the published Dart package via packages/llm_llamacpp/.pubignore.
#
# Several broad patterns above (Makefile, *.log, **/gradle-wrapper.jar) unintentionally
# match tracked files inside the native library, triggering `dart pub publish --dry-run`
# warnings. The negations below scope those patterns out of the llamacpp tree.
#
# Note: three files remain unavoidably gitignored by the native library's own internal
# .gitignore files (build-xcframework.sh, *.log inside llamacpp/, xcshareddata/*.plist).
# These cannot be un-ignored without modifying third-party code; they are correctly
# excluded from the published package by .pubignore.
!packages/llm_llamacpp/llamacpp
!packages/llm_llamacpp/llamacpp/**/Makefile
!packages/llm_llamacpp/llamacpp/**/gradle-wrapper.jar